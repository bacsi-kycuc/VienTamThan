<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🏥 Bệnh viện Tâm thần Đa khoa Kỹ Thuật Số</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@700;900&family=JetBrains+Mono:wght@300;400;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
<style>
  :root {
    --bg: #f0f4f8;
    --bg2: #e8f0f7;
    --bg3: #dce7f3;
    --card: #ffffff;
    --card2: #f5f9fc;
    --border: #b8d4e8;
    --border2: #a0c8e0;
    --primary: #0066cc;
    --primary-light: #1a7ee8;
    --accent: #d63031;
    --accent-light: #e84a4a;
    --success: #00a854;
    --success-light: #1ab394;
    --warning: #f59e0b;
    --text: #1e293b;
    --text-muted: #64748b;
    --radius: 16px;
    --radius-sm: 8px;
    --shadow: 0 4px 20px rgba(0,0,0,0.05);
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
  body { background: var(--bg); color: var(--text); overflow-x: hidden; min-height: 100vh; }

  /* MÀN HÌNH CHÀO MỪNG (WELCOME SCREEN) */
  #welcomeScreen {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: radial-gradient(circle at center, var(--bg2) 0%, var(--bg) 100%);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    transition: var(--transition);
  }
  #welcomeScreen.hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(1.02);
  }
  .welcome-title {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    color: var(--primary);
    text-align: center;
    margin-bottom: 10px;
  }
  .welcome-subtitle {
    color: var(--text-muted);
    font-size: 1.1rem;
    margin-bottom: 40px;
    text-align: center;
  }
  .zone-selection-container {
    display: flex;
    gap: 30px;
    max-width: 900px;
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
  }
  .zone-card {
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 24px;
    padding: 40px 30px;
    width: 380px;
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .zone-card:hover {
    transform: translateY(-8px);
    border-color: var(--primary);
    box-shadow: 0 12px 30px rgba(0,102,204,0.15);
  }
  .zone-card .icon {
    font-size: 4rem;
    margin-bottom: 20px;
  }
  .zone-card h3 {
    font-size: 1.6rem;
    color: var(--text);
    margin-bottom: 12px;
  }
  .zone-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* GIAO DIỆN CHÍNH */
  #app { display: none; padding: 20px; max-width: 1400px; margin: 0 auto; }
  #app.active { display: block; }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 30px;
    flex-wrap: wrap;
    gap: 15px;
  }
  
  .brand-zone-info { display: flex; align-items: center; gap: 20px; }
  .logo-title h1 { font-family: 'Playfair Display', serif; font-size: 1.5rem; color: var(--primary); }

  /* THANH TRƯỢT CHUYỂN KHU VỰC (SLIDER TOGGLE) */
  .zone-slider-wrapper {
    background: var(--bg3);
    padding: 4px;
    border-radius: 30px;
    display: flex;
    position: relative;
    width: 320px;
    user-select: none;
    cursor: pointer;
  }
  .zone-slider-btn {
    flex: 1;
    text-align: center;
    padding: 10px 0;
    font-weight: 600;
    font-size: 0.9rem;
    z-index: 2;
    transition: var(--transition);
    color: var(--text-muted);
  }
  .zone-slider-btn.active {
    color: white;
  }
  .zone-slider-bg {
    position: absolute;
    top: 4px; left: 4px;
    width: calc(50% - 4px);
    height: calc(100% - 8px);
    background: var(--primary);
    border-radius: 26px;
    z-index: 1;
    transition: var(--transition);
  }
  .zone-slider-wrapper.active-cai-nghien .zone-slider-bg {
    left: calc(50%);
    background: var(--accent);
  }

  .user-actions { display: flex; align-items: center; gap: 15px; }
  .btn {
    padding: 10px 20px; border-radius: var(--radius-sm); border: none;
    font-weight: 600; cursor: pointer; transition: var(--transition);
  }
  .btn-primary { background: var(--primary); color: white; }
  .btn-primary:hover { background: var(--primary-light); }
  .btn-outline { background: transparent; border: 1px solid var(--border2); color: var(--text); }
  .btn-outline:hover { background: var(--bg2); }

  /* CÁC PHẦN KHÁC GIỮ NGUYÊN HOẶC ĐIỀU CHỈNH NHẸ */
  .main-layout { display: grid; grid-template-columns: 280px 1fr; gap: 30px; }
  @media(max-width: 768px) { .main-layout { grid-template-columns: 1fr; } }

  .sidebar {
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow);
    align-self: start;
  }
  .sidebar h2 { font-size: 1.1rem; margin-bottom: 15px; color: var(--text-muted); font-weight: 700; }
  
  .genre-list { display: flex; flex-direction: column; gap: 8px; }
  .genre-item {
    padding: 12px 15px; border-radius: var(--radius-sm); cursor: pointer;
    transition: var(--transition); font-weight: 500; display: flex; align-items: center; gap: 10px;
  }
  .genre-item:hover, .genre-item.active { background: var(--bg2); color: var(--primary); }

  .content-area { display: flex; flex-direction: column; gap: 20px; }
  .search-bar {
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 15px 20px; box-shadow: var(--shadow);
    display: flex; gap: 15px;
  }
  .search-bar input {
    flex: 1; padding: 10px; border: 1px solid var(--border);
    border-radius: var(--radius-sm); outline: none; font-size: 1px; font-size: 1rem;
  }

  .prompt-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
  .prompt-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow);
    transition: var(--transition); cursor: pointer; position: relative;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .prompt-card:hover { transform: translateY(-4px); border-color: var(--border2); }
  .prompt-card h3 { font-size: 1.2rem; margin-bottom: 10px; color: var(--text); }
  .prompt-card p { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 15px; }

  /* ZONE BADGE TRÊN PROMPT */
  .zone-badge {
    position: absolute; top: 15px; right: 15px; font-size: 0.75rem;
    padding: 4px 8px; border-radius: 12px; font-weight: 700; text-transform: uppercase;
  }
  .zone-badge.hospital { background: #e0f2fe; color: var(--primary); }
  .zone-badge.cai-nghien { background: #ffe4e6; color: var(--accent); }

  /* MODAL */
  .modal {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center; z-index: 1000;
    opacity: 0; pointer-events: none; transition: var(--transition);
  }
  .modal.show { opacity: 1; pointer-events: auto; }
  .modal-content {
    background: var(--card); border-radius: var(--radius);
    padding: 30px; width: 100%; max-width: 500px; box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    position: relative; transform: scale(0.95); transition: var(--transition);
  }
  .modal.show .modal-content { transform: scale(1); }
  .modal-header { font-size: 1.4rem; font-weight: 700; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;}
  .close-modal { cursor: pointer; font-size: 1.5rem; color: var(--text-muted); }

  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem; }
  .form-group input, .form-group textarea, .form-group select {
    width: 100%; padding: 10px; border: 1px solid var(--border);
    border-radius: var(--radius-sm); outline: none; font-size: 0.95rem;
  }
  
  /* CHỌN KHU VỰC TRONG ADMIN FORM */
  .radio-group-zone {
    display: flex; gap: 20px; margin-top: 5px;
  }
  .radio-label {
    display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 500 !important;
  }
  .radio-label input { width: auto; cursor: pointer; }

  .error-msg { color: var(--accent); font-size: 0.85rem; margin-top: 5px; display: none; }
  .error-msg.show { display: block; }
</style>
</head>
<body>

  <div id="welcomeScreen">
    <h1 class="welcome-title">🏥 VIỆN TÂM THẦN ĐA KHOA KỸ THUẬT SỐ</h1>
    <p class="welcome-subtitle">Vui lòng chọn phân khu quản lý để tiếp tục trải nghiệm hệ thống</p>
    <div class="zone-selection-container">
      <div class="zone-card" onclick="selectInitialZone('hospital')">
        <div class="icon">🏥</div>
        <h3>Khu Bệnh Viện</h3>
        <p>Nơi lưu trữ và tổng hợp các Prompt thông thường, hỗ trợ điều trị tâm lý cơ bản và tác vụ văn phòng số.</p>
      </div>
      <div class="zone-card" onclick="selectInitialZone('cai-nghien')">
        <div class="icon">💊</div>
        <h3>Trại Cai Nghiện</h3>
        <p>Khu vực đặc biệt dành riêng cho các Prompt cấp cao, điều chỉnh tư duy chuyên sâu và nghiên cứu hành vi đặc biệt.</p>
      </div>
    </div>
  </div>

  <div id="app">
    <header>
      <div class="brand-zone-info">
        <div class="logo-title">
          <h1>🏥 VIỆN TÂM THẦN CỐ THỊ</h1>
        </div>
        
        <div class="zone-slider-wrapper" id="zoneSlider" onclick="toggleZoneSlider()">
          <div class="zone-slider-btn id-hospital active" id="btnSliderHospital">🏥 Bệnh Viện</div>
          <div class="zone-slider-btn id-cainghien" id="btnSliderCaiNghien">💊 Trại Cai Nghiện</div>
          <div class="zone-slider-bg"></div>
        </div>
      </div>

      <div class="user-actions">
        <span id="adminBadge" style="display:none; background: #fef3c7; color: #d97706; padding: 6px 12px; border-radius: 20px; font-weight: 700; font-size: 0.85rem;">👑 ADMIN</span>
        <button class="btn btn-outline" id="loginBtn" onclick="openModal('loginModal')">⚙ Admin</button>
        <button class="btn btn-primary" id="adminPanelBtn" style="display:none;" onclick="openModal('promptModal')">+ Thêm Prompt</button>
        <button class="btn btn-outline" id="logoutBtn" style="display:none; color: var(--accent); border-color: var(--accent);" onclick="logoutAdmin()">Đăng xuất</button>
      </div>
    </header>

    <div class="main-layout">
      <div class="sidebar">
        <h2>DANH SÁCH KHOA</h2>
        <div class="genre-list" id="genreList">
          </div>
      </div>

      <div class="content-area">
        <div class="search-bar">
          <input type="text" id="searchInput" placeholder="Tìm kiếm tên prompt hoặc từ khóa..." oninput="renderPrompts()">
        </div>

        <div class="prompt-grid" id="promptGrid">
          </div>
      </div>
    </div>
  </div>

  <div class="modal" id="loginModal">
    <div class="modal-content">
      <div class="modal-header">
        <span>Đăng nhập hệ thống Admin</span>
        <span class="close-modal" onclick="closeModal('loginModal')">&times;</span>
      </div>
      <div class="form-group">
        <label>Email Quản trị</label>
        <input type="email" id="loginEmail" placeholder="admin@gmail.com" value="charmaineminnie8@gmail.com">
      </div>
      <div class="form-group">
        <label>Mật mã Master</label>
        <input type="password" id="loginPassword" placeholder="••••••••" value="BenhVienAdmin2024">
      </div>
      <div class="error-msg" id="loginError">Tài khoản hoặc mật mã Admin không hợp lệ!</div>
      <button class="btn btn-primary" style="width:100%; margin-top:10px;" onclick="checkAdminLogin()">Đăng Nhập</button>
    </div>
  </div>

  <div class="modal" id="promptModal">
    <div class="modal-content">
      <div class="modal-header">
        <span id="formTitle">Tạo Prompt Mới</span>
        <span class="close-modal" onclick="closeModal('promptModal')">&times;</span>
      </div>
      <div class="form-group">
        <label>Phân bổ Khu vực dữ liệu</label>
        <div class="radio-group-zone">
          <label class="radio-label">
            <input type="radio" name="promptZone" value="hospital" checked> 🏥 Bệnh Viện
          </label>
          <label class="radio-label">
            <input type="radio" name="promptZone" value="cai-nghien"> 💊 Trại Cai Nghiện
          </label>
        </div>
      </div>
      <div class="form-group">
        <label>Tên Prompt / Liệu pháp</label>
        <input type="text" id="pName" placeholder="Ví dụ: Prompt Điều Hướng Hành Vi">
      </div>
      <div class="form-group">
        <label>Thuộc Khoa bệnh</label>
        <select id="pGenre">
          <option value="hoang-tuong">🧠 Khoa Hoang Tưởng</option>
          <option value="tram-cam">🌧️ Khoa Trầm Cảm</option>
          <option value="da-nhan-cach">👥 Khoa Đa Nhân Cách</option>
        </select>
      </div>
      <div class="form-group">
        <label>Nội dung Prompt chi tiết</label>
        <textarea id="pContent" rows="5" placeholder="Nhập câu lệnh prompt tại đây..."></textarea>
      </div>
      <div class="form-group">
        <label>Mật mã bảo vệ bài viết (Bỏ trống nếu muốn công khai)</label>
        <input type="text" id="pPassword" placeholder="Nhập mật mã nếu cần khóa">
      </div>
      <button class="btn btn-primary" style="width:100%; margin-top:10px;" onclick="savePrompt()">Lưu Dữ Liệu</button>
    </div>
  </div>

  <div class="modal" id="unlockModal">
    <div class="modal-content">
      <div class="modal-header">
        <span>🔒 Prompt này yêu cầu mật mã mở khóa</span>
        <span class="close-modal" onclick="closeModal('unlockModal')">&times;</span>
      </div>
      <div class="form-group">
        <label>Vui lòng nhập mật mã bệnh án để xem</label>
        <input type="password" id="unlockPassword" placeholder="••••••••">
      </div>
      <div class="error-msg" id="unlockError">Mật mã mở khóa không chính xác!</div>
      <button class="btn btn-primary" style="width:100%; margin-top:10px;" onclick="unlockPrompt()">Xác Nhận Mở Khóa</button>
    </div>
  </div>

  <script>
    // Khởi tạo dữ liệu mẫu nếu chưa có
    let currentZone = 'hospital'; // Mặc định ban đầu
    let currentGenre = 'all';
    let isAdmin = false;
    let currentPromptIdx = null;

    let prompts = JSON.parse(localStorage.getItem('hospital_prompts')) || [
      { zone: 'hospital', name: 'Prompt Kiểm Soát Sự Tập Trung', genre: 'hoang-tuong', content: 'Hãy đóng vai chuyên gia tập trung...', password: '' },
      { zone: 'cai-nghien', name: 'Prompt Nghiên Cứu Ám Ảnh Kháng Cự', genre: 'hoang-tuong', content: 'Phân tích các phản ứng ám ảnh cưỡng chế...', password: '123' },
      { zone: 'hospital', name: 'Prompt Xoa Dịu Cơn Khủng Hoảng Lo Âu', genre: 'tram-cam', content: 'Tạo lập không gian trò chuyện an toàn...', password: '' }
    ];

    const genres = [
      { id: 'all', name: '📁 Tất Cả Các Khoa' },
      { id: 'hoang-tuong', name: '🧠 Khoa Hoang Tưởng' },
      { id: 'tram-cam', name: '🌧️ Khoa Trầm Cảm' },
      { id: 'da-nhan-cach', name: '👥 Khoa Đa Nhân Cách' }
    ];

    // 1. CHỌN KHU VỰC TỪ MÀN HÌNH CHÀO MỪNG
    function selectInitialZone(zone) {
      currentZone = zone;
      
      // Đồng bộ thanh trượt ở giao diện chính theo đúng khu vực đã chọn
      const slider = document.getElementById('zoneSlider');
      if (zone === 'cai-nghien') {
        slider.classList.add('active-cai-nghien');
        document.getElementById('btnSliderHospital').classList.remove('active');
        document.getElementById('btnSliderCaiNghien').classList.add('active');
      } else {
        slider.classList.remove('active-cai-nghien');
        document.getElementById('btnSliderHospital').classList.add('active');
        document.getElementById('btnSliderCaiNghien').classList.remove('active');
      }

      // Ẩn màn hình chào mừng và kích hoạt ứng dụng chính
      document.getElementById('welcomeScreen').classList.add('hidden');
      document.getElementById('app').classList.add('active');
      
      initApp();
    }

    // 2. TÍNH NĂNG TRƯỢT CHUYỂN KHU VỰC TRÊN HEADER (TOGGLE SLIDER)
    function toggleZoneSlider() {
      const slider = document.getElementById('zoneSlider');
      if (currentZone === 'hospital') {
        currentZone = 'cai-nghien';
        slider.classList.add('active-cai-nghien');
        document.getElementById('btnSliderHospital').classList.remove('active');
        document.getElementById('btnSliderCaiNghien').classList.add('active');
      } else {
        currentZone = 'hospital';
        slider.classList.remove('active-cai-nghien');
        document.getElementById('btnSliderHospital').classList.add('active');
        document.getElementById('btnSliderCaiNghien').classList.remove('active');
      }
      renderPrompts();
    }

    // KHỞI ĐỘNG GIAO DIỆN HỆ THỐNG
    function initApp() {
      renderGenres();
      renderPrompts();
      checkSavedLogin();
    }

    // HIỂN THỊ DANH SÁCH KHOA
    function renderGenres() {
      const list = document.getElementById('genreList');
      list.innerHTML = genres.map(g => `
        <div class="genre-item ${currentGenre === g.id ? 'active' : ''}" onclick="selectGenre('${g.id}')">
          ${g.name}
        </div>
      `).join('');
    }

    function selectGenre(genreId) {
      currentGenre = genreId;
      renderGenres();
      renderPrompts();
    }

    // RENDER PROMPT THEO KHU VỰC VÀ THEO KHOA ĐÃ CHỌN
    function renderPrompts() {
      const grid = document.getElementById('promptGrid');
      const search = document.getElementById('searchInput').value.toLowerCase();

      // Lọc theo Khu Vực (Bệnh viện hay Trại cai nghiện) -> Lọc theo Khoa -> Lọc theo ô Tìm kiếm
      const filtered = prompts.filter(p => {
        const matchZone = (p.zone || 'hospital') === currentZone;
        const matchGenre = currentGenre === 'all' || p.genre === currentGenre;
        const matchSearch = p.name.toLowerCase().includes(search) || p.content.toLowerCase().includes(search);
        return matchZone && matchGenre && matchSearch;
      });

      if (filtered.length === 0) {
        grid.innerHTML = `<div style="grid-column: 1/-1; text-align:center; color: var(--text-muted); padding: 40px;">Khu vực này hiện chưa có bệnh án Prompt nào được đăng tải.</div>`;
        return;
      }

      grid.innerHTML = filtered.map((p, idx) => {
        // Tìm vị trí gốc thực tế trong mảng tổng dữ liệu
        const originalIdx = prompts.findIndex(original => original.name === p.name && original.content === p.content);
        return `
          <div class="prompt-card" onclick="viewPrompt(${originalIdx})">
            <span class="zone-badge ${p.zone === 'cai-nghien' ? 'cai-nghien' : 'hospital'}">
              ${p.zone === 'cai-nghien' ? '💊 Cai Nghiện' : '🏥 Bệnh Viện'}
            </span>
            <div>
              <h3 style="margin-top: 15px;">${p.name}</h3>
              <p>${p.content.substring(0, 100)}...</p>
            </div>
            <div style="font-weight:700; font-size:0.85rem; color:${p.password ? 'var(--accent)' : 'var(--success)'}">
              ${p.password ? '🔒 ĐÃ KHÓA' : '🔓 CÔNG KHAI'}
            </div>
          </div>
        `;
      }).join('');
    }

    // XEM VÀ MỞ KHÓA PROMPT
    function viewPrompt(idx) {
      currentPromptIdx = idx;
      const prompt = prompts[idx];
      if (prompt.password) {
        document.getElementById('unlockPassword').value = '';
        document.getElementById('unlockError').classList.remove('show');
        openModal('unlockModal');
      } else {
        alert(`📖 NỘI DUNG PROMPT:\n\n${prompt.content}`);
      }
    }

    function unlockPrompt() {
      const inputPw = document.getElementById('unlockPassword').value;
      const targetPrompt = prompts[currentPromptIdx];
      
      if (inputPw === targetPrompt.password) {
        closeModal('unlockModal');
        setTimeout(() => {
          alert(`🔓 MỞ KHÓA THÀNH CÔNG:\n\n${targetPrompt.content}`);
        }, 100);
      } else {
        document.getElementById('unlockError').classList.add('show');
      }
    }

    // XỬ LÝ ĐĂNG NHẬP ADMIN (ĐÃ SỬA LỖI KHỚP PASS CHỮ THƯỜNG)
    function checkAdminLogin() {
      const email = document.getElementById('loginEmail').value;
      const password = document.getElementById('loginPassword').value;
      
      // So sánh trực tiếp chuỗi chữ thường "BenhVienAdmin2024"
      if (email === 'charmaineminnie8@gmail.com' && password === 'BenhVienAdmin2024') {
        isAdmin = true;
        localStorage.setItem('hospital_admin_logged', 'true');
        document.getElementById('loginError').classList.remove('show');
        closeModal('loginModal');
        updateAdminUI();
      } else {
        document.getElementById('loginError').classList.add('show');
      }
    }

    function checkSavedLogin() {
      if (localStorage.getItem('hospital_admin_logged') === 'true') {
        isAdmin = true;
        updateAdminUI();
      }
    }

    function updateAdminUI() {
      if (isAdmin) {
        document.getElementById('loginBtn').style.display = 'none';
        document.getElementById('adminBadge').style.display = 'inline-block';
        document.getElementById('adminPanelBtn').style.display = 'inline-block';
        document.getElementById('logoutBtn').style.display = 'inline-block';
      }
    }

    function logoutAdmin() {
      isAdmin = false;
      localStorage.removeItem('hospital_admin_logged');
      document.getElementById('loginBtn').style.display = 'inline-block';
      document.getElementById('adminBadge').style.display = 'none';
      document.getElementById('adminPanelBtn').style.display = 'none';
      document.getElementById('logoutBtn').style.display = 'none';
    }

    // LƯU PROMPT MỚI CHO ADMIN (ĐÃ CÓ THÊM CHỌN KHU VỰC)
    function savePrompt() {
      const zone = document.querySelector('input[name="promptZone"]:checked').value;
      const name = document.getElementById('pName').value;
      const genre = document.getElementById('pGenre').value;
      const content = document.getElementById('pContent').value;
      const password = document.getElementById('pPassword').value;

      if (!name || !content) {
        alert('Vui lòng điền tên và nội dung prompt đầy đủ!');
        return;
      }

      prompts.push({ zone, name, genre, content, password });
      localStorage.setItem('hospital_prompts', JSON.stringify(prompts));
      
      alert('✅ Thêm dữ liệu prompt vào phân khu thành công!');
      closeModal('promptModal');
      
      // Reset form gọn gàng
      document.getElementById('pName').value = '';
      document.getElementById('pContent').value = '';
      document.getElementById('pPassword').value = '';
      
      renderPrompts();
    }

    // QUẢN LÝ ĐÓNG MỞ MODAL
    function openModal(id) {
      document.getElementById(id).classList.add('show');
    }
    function closeModal(id) {
      document.getElementById(id).classList.remove('show');
    }
  </script>
</body>
</html>
